[Unit]
Description=M.A.R.A.N.D.U. HIPS Dashboard (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=marandu
Group=marandu
WorkingDirectory=/home/marandu/MARANDU/web
ExecStart=/home/marandu/MARANDU/web/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Endurecimiento adicional del servicio (además de correr sin root):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/marandu/MARANDU
ProtectHome=false

[Install]
WantedBy=multi-user.target
